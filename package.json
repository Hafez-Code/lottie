{
  "name": "text-to-lottie",
  "productName": "Studio ProMax",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "diffusion-studio": "cli/diffusion-studio.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:text-slots": "node --experimental-strip-types --test scripts/text-slot-unicode.test.mjs",
    "check:workflow": "node --test scripts/chat-service.test.cjs scripts/api-provider.test.cjs scripts/scene-inspection.test.cjs scripts/agent-review.test.cjs scripts/agent-review-verified.test.cjs",
    "preview": "vite preview",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac dir",
    "postinstall": "node scripts/copy-canvaskit.mjs",
    "check:contact-sheet": "node --experimental-strip-types --test scripts/contact-sheet.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@kobalte/core": "^0.13.11",
    "@solidjs/router": "^0.16.1",
    "canvaskit-wasm": "^0.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-solid": "^1.18.0",
    "shadcn": "^4.11.0",
    "solid-js": "^1.9.9",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-solid-svg": "^0.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^25.9.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "solid-devtools": "^0.34.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-solid": "^2.11.8"
  }
}
